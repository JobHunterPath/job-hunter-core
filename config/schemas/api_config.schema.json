{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "api_config",
  "type": "object",
  "required": ["http", "profile"],
  "properties": {
    "agent_ai": {
      "type": "object",
      "required": ["execution"],
      "properties": {
        "execution": { "type": "string", "enum": ["agent_only"] }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "env_var": { "type": "string" },
          "app_id_env_var": { "type": "string" },
          "api_key_env_var": { "type": "string" }
        }
      }
    },
    "http": {
      "type": "object",
      "required": ["search_providers", "job_boards"],
      "properties": {
        "api_budgets": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "state_path": { "type": "string" },
            "monthly_limits": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "search_providers": {
          "type": "object",
          "properties": {
            "ats_discovery": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "greenhouse", "lever", "ashby", "smartrecruiters",
                      "workable", "personio", "recruitee", "hibob",
                      "teamtailor", "breezy", "workday"
                    ]
                  }
                }
              }
            },
            "ai_web_search": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "run_if_fewer_than_jobs": { "type": "integer", "minimum": 0 },
                "prompt_delay_seconds": { "type": "number", "minimum": 0 },
                "max_prompts_per_run": { "type": "integer", "minimum": 0 },
                "max_prompts_per_region": { "type": "integer", "minimum": 0 },
                "max_results_per_prompt": { "type": "integer", "minimum": 0 },
                "max_results_per_region": { "type": "integer", "minimum": 0 },
                "max_total_results_per_run": { "type": "integer", "minimum": 0 },
                "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "sources": { "type": "object" }
              }
            }
          }
        },
        "ats_scraper": {
          "type": "object",
          "properties": {
            "hibob_playwright_timeout_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "jd_fetcher": {
          "type": "object",
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "min_text_length": { "type": "integer", "minimum": 0 },
            "max_description_chars": { "type": "integer", "minimum": 100 },
            "title_min_chars": { "type": "integer", "minimum": 1 },
            "title_max_chars": { "type": "integer", "minimum": 1 },
            "hash_chars": { "type": "integer", "minimum": 4 }
          }
        },
        "pdf": {
          "type": "object",
          "properties": {
            "texlive_image": { "type": "string" },
            "docker_pull_timeout_seconds": { "type": "integer", "minimum": 30 },
            "pdflatex_timeout_seconds": { "type": "integer", "minimum": 10 },
            "docker_timeout_seconds": { "type": "integer", "minimum": 10 },
            "log_tail_chars": { "type": "integer", "minimum": 100 }
          }
        },
        "job_boards": {
          "type": "object",
          "properties": {
            "arbeitnow": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "arbeitsagentur": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "himalayas": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "remotive": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "the_muse": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "jsearch": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "adzuna": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "reed": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "jobspy": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "hours_old": { "type": "integer", "minimum": 1 }
              }
            },
            "jobicy": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "remoteok": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "weworkremotely": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "jooble": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "mycareersfuture": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "eures": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "jobbank": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "wttj": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "glints": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "irishjobs": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "gulftalent": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "naukrigulf": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "jobstreet": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["resume_tex", "story_bank", "latex_class"],
      "properties": {
        "resume_tex": { "type": "string" },
        "story_bank": { "type": "string" },
        "cover_letter_config": { "type": "string" },
        "scoring_config": { "type": "string" },
        "tailoring_config": { "type": "string" },
        "profile_image": { "type": "string" },
        "latex_class": { "type": "string" }
      }
    }
  }
}
