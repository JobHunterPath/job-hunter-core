{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cover_letter_config",
  "type": "object",
  "required": ["cover_letter"],
  "additionalProperties": false,
  "properties": {
    "cover_letter": {
      "type": "object",
      "required": ["structure", "tone", "content"],
      "properties": {
        "structure": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "max_sentences": { "type": "integer", "minimum": 1 },
              "purpose": { "type": "string" }
            }
          }
        },
        "tone": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "forbidden": {
          "type": "object",
          "properties": {
            "style": { "type": "array", "items": { "type": "string" } },
            "phrases": { "type": "array", "items": { "type": "string" } }
          }
        },
        "closing": {
          "type": "object",
          "properties": {
            "format": { "type": "string" }
          }
        },
        "stories": {
          "type": "object",
          "properties": {
            "source_file": { "type": "string" },
            "section": { "type": "string" },
            "rules": { "type": "array", "items": { "type": "string" } }
          }
        },
        "content": {
          "type": "object",
          "required": ["target_words", "max_words"],
          "properties": {
            "target_words": { "type": "integer", "minimum": 50 },
            "max_words": { "type": "integer", "minimum": 50 },
            "paragraphs": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
