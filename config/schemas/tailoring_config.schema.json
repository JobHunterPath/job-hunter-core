{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tailoring_config",
  "type": "object",
  "required": ["tailoring"],
  "additionalProperties": false,
  "properties": {
    "tailoring": {
      "type": "object",
      "required": ["rules", "stories"],
      "properties": {
        "rules": {
          "type": "object",
          "properties": {
            "allowed_modifications": { "type": "array", "items": { "type": "string" } },
            "forbidden_modifications": { "type": "array", "items": { "type": "string" } },
            "summary": {
              "type": "object",
              "properties": {
                "min_lines": { "type": "integer", "minimum": 1 },
                "max_lines": { "type": "integer", "minimum": 1 },
                "no_em_dashes": { "type": "boolean" },
                "tone": { "type": "string" },
                "proof_point_preferences": { "type": "array", "items": { "type": "string" } }
              }
            },
            "bullets": {
              "type": "object",
              "properties": {
                "min_per_role": { "type": "integer", "minimum": 0 },
                "max_per_role": { "type": "integer", "minimum": 1 },
                "max_lines_per_bullet": { "type": "integer", "minimum": 1 },
                "allowed_verb_tenses": { "type": "array", "items": { "type": "string" } },
                "forbidden_repeated_verbs_count": { "type": "integer", "minimum": 1 },
                "bullet_format": { "type": "string" },
                "tailor_priority": { "type": "string" }
              }
            },
            "skills": {
              "type": "object",
              "properties": {
                "reorder_by_jd_priority": { "type": "boolean" },
                "add_new_skills": { "type": "boolean" }
              }
            },
            "projects": {
              "type": "object",
              "properties": {
                "enabled_when_section_active": { "type": "boolean" },
                "max_projects": { "type": "integer", "minimum": 0 },
                "max_total_resume_pages": { "type": "integer", "minimum": 1 }
              }
            },
            "preserve_latex": { "type": "boolean" },
            "preserve_formatting": { "type": "boolean" },
            "preserve_commands": { "type": "boolean" }
          }
        },
        "stories": {
          "type": "object",
          "required": ["story_bank", "max_chars_for_tailoring"],
          "properties": {
            "story_bank": { "type": "string" },
            "max_chars_for_tailoring": { "type": "integer", "minimum": 1000 },
            "require_evidence_from_resume_or_story_bank": { "type": "boolean" }
          }
        }
      }
    }
  }
}
